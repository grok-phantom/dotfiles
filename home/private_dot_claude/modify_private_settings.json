{{- /* chezmoi:modify-template */ -}}
{{- $claudeProxy := get . "claude_proxy" -}}
{{- if not (kindIs "bool" $claudeProxy) -}}
{{-   $claudeProxy = and (eq .chezmoi.os "darwin") (not (get . "ephemeral")) -}}
{{- end -}}
{{- $wanted := dict -}}
{{- if $claudeProxy -}}
{{-   $proxy := includeTemplate "proxy.json.tmpl" . | fromJson -}}
{{-   $proxyURL := printf "http://%s:%s" $proxy.host $proxy.http_port -}}
{{-   $noProxy := $proxy.no_proxy -}}
{{-   $wanted = dict "HTTP_PROXY" $proxyURL "HTTPS_PROXY" $proxyURL "http_proxy" $proxyURL "https_proxy" $proxyURL "NO_PROXY" $noProxy "no_proxy" $noProxy -}}
{{- end -}}
{{- /* automation_git: git run by Claude Code never waits for a 1Password approval. GitHub goes over HTTPS
       with gh's token, and commits are signed with a key file kept only on this machine. */ -}}
{{- $gh := "gh" -}}
{{- if lookPath "gh" -}}{{- $gh = lookPath "gh" -}}{{- end -}}
{{- $gitConfig := list
      (list "credential.https://github.com.helper" "")
      (list "credential.https://github.com.helper" (printf "!%s auth git-credential" $gh))
      (list "url.https://github.com/.insteadOf" "git@github.com:")
      (list "url.https://github.com/.insteadOf" "ssh://git@github.com/")
      (list "gpg.ssh.program" "ssh-keygen")
      (list "user.signingkey" (printf "%s/.ssh/automation-signing" .chezmoi.homeDir)) -}}
{{- $settings := .chezmoi.stdin | trim | default "{}" | fromJson -}}
{{- if not (kindIs "map" $settings) -}}
{{-   fail "Claude settings.json must contain a JSON object" -}}
{{- end -}}
{{- if and (hasKey $settings "env") (not (kindIs "map" (get $settings "env"))) -}}
{{-   fail "Claude settings.json env must contain a JSON object" -}}
{{- end -}}
{{- $env := get $settings "env" | default (dict) -}}
{{- $ownsGitConfig := eq (toString (get $env "GIT_CONFIG_KEY_0")) (index $gitConfig 0 0) -}}
{{- if get . "automation_git" -}}
{{-   $_ := set $wanted "GIT_CONFIG_COUNT" (len $gitConfig | toString) -}}
{{-   range $i, $entry := $gitConfig -}}
{{-     $_ := set $wanted (printf "GIT_CONFIG_KEY_%d" $i) (index $entry 0) -}}
{{-     $_ := set $wanted (printf "GIT_CONFIG_VALUE_%d" $i) (index $entry 1) -}}
{{-   end -}}
{{- end -}}
{{- $changed := false -}}
{{- /* Managed hook groups, recognised by their command so hooks added by hand are left alone.
       roost_hooks: report agent state to roost (tmux pane options and phone pushes, see the roost repo).
       tmux_agent_notify: inside tmux, turn Notification/Stop into OSC 777 notifications, which cmux's
       remote tmux mirror shows per workspace (its own remote hooks carry only the agent state). */ -}}
{{- $allEvents := list "SessionStart" "UserPromptSubmit" "PreToolUse" "PostToolUse" "PostToolUseFailure" "PermissionRequest" "PermissionDenied" "Notification" "Stop" "StopFailure" "SessionEnd" -}}
{{- $managed := list
      (dict "command" (printf "%s/bin/roost hook claude" .chezmoi.homeDir) "timeout" 10 "events" $allEvents "on" (get . "roost_hooks"))
      (dict "command" (printf "%s/bin/tmux-agent-notify" .chezmoi.homeDir) "timeout" 5 "events" (list "Notification" "Stop") "on" (get . "tmux_agent_notify")) -}}
{{- if and (hasKey $settings "hooks") (not (kindIs "map" (get $settings "hooks"))) -}}
{{-   fail "Claude settings.json hooks must contain a JSON object" -}}
{{- end -}}
{{- $hooks := get $settings "hooks" | default (dict) -}}
{{- $hooksChanged := false -}}
{{- range $m := $managed -}}
{{-   $command := $m.command -}}
{{-   $wantedGroup := dict "hooks" (list (dict "type" "command" "command" $command "timeout" $m.timeout)) -}}
{{-   range $event := $allEvents -}}
{{-     $kept := list -}}
{{-     $ours := list -}}
{{-     range $group := get $hooks $event | default (list) -}}
{{-       $mine := false -}}
{{-       range $hook := get $group "hooks" | default (list) -}}
{{-         if eq (toString (get $hook "command")) $command -}}{{- $mine = true -}}{{- end -}}
{{-       end -}}
{{-       if $mine -}}{{- $ours = append $ours $group -}}{{- else -}}{{- $kept = append $kept $group -}}{{- end -}}
{{-     end -}}
{{-     if and $m.on (has $event $m.events) -}}
{{-       if not (and (eq (len $ours) 1) (eq (index $ours 0 | toJson) ($wantedGroup | toJson))) -}}
{{-         $hooksChanged = true -}}
{{-         $_ := set $hooks $event (append $kept $wantedGroup) -}}
{{-       end -}}
{{-     else if $ours -}}
{{-       $hooksChanged = true -}}
{{-       if $kept -}}{{- $_ := set $hooks $event $kept -}}{{- else -}}{{- $_ := unset $hooks $event -}}{{- end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if $hooksChanged -}}
{{-   $changed = true -}}
{{-   if $hooks -}}{{- $_ := set $settings "hooks" $hooks -}}{{- else -}}{{- $_ := unset $settings "hooks" -}}{{- end -}}
{{- end -}}
{{- range $key, $value := $wanted -}}
{{-   if not (and (hasKey $env $key) (eq (toString (get $env $key)) $value)) -}}
{{-     $changed = true -}}
{{-     $_ := set $env $key $value -}}
{{-   end -}}
{{- end -}}
{{- /* Switching automation_git off removes only the git entries this file wrote. */ -}}
{{- if and $ownsGitConfig (not (get . "automation_git")) -}}
{{-   $changed = true -}}
{{-   $_ := unset $env "GIT_CONFIG_COUNT" -}}
{{-   range $i, $entry := $gitConfig -}}
{{-     $_ := unset $env (printf "GIT_CONFIG_KEY_%d" $i) -}}
{{-     $_ := unset $env (printf "GIT_CONFIG_VALUE_%d" $i) -}}
{{-   end -}}
{{- end -}}
{{- /* Re-serializing sorts keys; keep Claude's own formatting when nothing needs to change. */ -}}
{{- if $changed -}}
{{-   if or $env (hasKey $settings "env") -}}{{- $_ := set $settings "env" $env -}}{{- end -}}
{{ toPrettyJson $settings -}}
{{ else -}}
{{ .chezmoi.stdin }}
{{- end -}}
