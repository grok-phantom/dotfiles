{{- /* chezmoi:modify-template */ -}}
{{- $proxy := includeTemplate "proxy.json.tmpl" . | fromJson -}}
{{- $proxyURL := printf "http://%s:%s" $proxy.host $proxy.http_port -}}
{{- $noProxy := "localhost,127.0.0.1,::1" -}}
{{- $wanted := dict "HTTP_PROXY" $proxyURL "HTTPS_PROXY" $proxyURL "http_proxy" $proxyURL "https_proxy" $proxyURL "NO_PROXY" $noProxy "no_proxy" $noProxy -}}
{{- $settings := .chezmoi.stdin | trim | default "{}" | fromJson -}}
{{- if not (kindIs "map" $settings) -}}
{{-   fail "Claude settings.json must contain a JSON object" -}}
{{- end -}}
{{- if and (hasKey $settings "env") (not (kindIs "map" (get $settings "env"))) -}}
{{-   fail "Claude settings.json env must contain a JSON object" -}}
{{- end -}}
{{- $env := get $settings "env" | default (dict) -}}
{{- $changed := false -}}
{{- range $key, $value := $wanted -}}
{{-   if not (and (hasKey $env $key) (eq (toString (get $env $key)) $value)) -}}
{{-     $changed = true -}}
{{-     $settings = setValueAtPath (printf "env.%s" $key) $value $settings -}}
{{-   end -}}
{{- end -}}
{{- /* Re-serializing sorts keys; keep Claude's own formatting when nothing needs to change. */ -}}
{{- if $changed -}}
{{ toPrettyJson $settings -}}
{{ else -}}
{{ .chezmoi.stdin }}
{{- end -}}
{{- /* vim: set filetype=gotmpl: */ -}}
