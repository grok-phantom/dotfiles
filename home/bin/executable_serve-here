#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: serve-here [port] [directory]
       serve-here [directory]

Start a simple HTTP file server. Defaults to port 8000 and current directory.

Environment:
  SERVE_HERE_BIND   Bind address. Defaults to 127.0.0.1.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "serve-here: requires python3" >&2
  exit 127
fi

port="8000"
directory="."
bind="${SERVE_HERE_BIND:-127.0.0.1}"

if [[ $# -ge 1 ]]; then
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    port="$1"
    shift
  else
    directory="$1"
    shift
  fi
fi

if [[ $# -ge 1 ]]; then
  directory="$1"
  shift
fi

if [[ $# -ne 0 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -d "$directory" ]]; then
  echo "serve-here: not a directory: $directory" >&2
  exit 1
fi

echo "serving $directory at http://$bind:$port/"
exec python3 -m http.server "$port" --bind "$bind" --directory "$directory"
