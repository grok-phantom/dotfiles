#!/usr/bin/env bash
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title MBA · Sync
# @raycast.mode silent
# Optional parameters:
# @raycast.icon 🔄
# @raycast.packageName MBA
# @raycast.description Copy the Finder selection (or a path) to or from the same place under ~ on the remote dev host.
# @raycast.argument1 { "type": "dropdown", "placeholder": "direction", "data": [{"title": "Push", "value": "--push"}, {"title": "Pull", "value": "--pull"}] }
# @raycast.argument2 { "type": "text", "placeholder": "path under ~", "optional": true }
set -eufo pipefail

usage() {
  cat <<'EOF'
usage: mba-sync [-H host] [-r | --pull] [-n] [--all] [path ...]

Copy each PATH (default: the current directory) with rsync over SSH to the
same path relative to ~ on a remote host, e.g. ~/workspace/x -> host:~/workspace/x.
With -r (--pull) copy the other way, from host:~/x to ~/x.
A directory's contents are merged into the other side's directory, which is
created if missing. Paths must be inside ~.

Nothing is ever deleted, and a file that is newer on the receiving side is
left alone, so edits made there are not overwritten.

  -r, --pull  copy from the remote host to here (--push, the default, copies there)
  -n          dry run: list what would change, change nothing
  --all       include .git and files that .gitignore excludes

By default .git, .DS_Store and files .gitignore excludes are skipped, so each
checkout keeps its own Git state and build output. When pulling, the remote
directory must be a Git work tree for .gitignore to apply.

Without a terminal (e.g. from Raycast) and without PATH, the Finder selection
is used and the result is shown as a notification.

Host: -H, else $MBA_HOST, else the first line of ~/.config/mba/host
(every mba-* command reads it).
EOF
}

notify() {
  osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "MBA"' \
    -e 'end run' "$1" >/dev/null 2>&1 || true
}
fail() {
  echo "mba-sync: $1" >&2
  [[ -t 1 ]] || notify "$1"
  exit 1
}

# Absolute path with . and .. resolved by name only, so ~/workspace stays
# ~/workspace even when it is a symlink, and the path need not exist yet.
normalize() {
  local path="$1" part
  local -a parts=()
  [[ "$path" == /* ]] || path="$PWD/$path"
  local IFS=/
  for part in $path; do
    case "$part" in
      "" | .) ;;
      ..) [[ ${#parts[@]} -eq 0 ]] || unset "parts[$((${#parts[@]} - 1))]" ;;
      *) parts+=("$part") ;;
    esac
  done
  [[ ${#parts[@]} -gt 0 ]] && printf '/%s' "${parts[@]}" || printf '/'
}

host="${MBA_HOST:-}"
pull=false
dry_run=false
all=false
while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    -H) host="${2:?mba-sync: -H needs a host}"; shift 2 ;;
    -r | --pull) pull=true; shift ;;
    --push) pull=false; shift ;;
    -n | --dry-run) dry_run=true; shift ;;
    --all) all=true; shift ;;
    --) shift; break ;;
    -*) usage >&2; exit 2 ;;
    *) break ;;
  esac
done
if [[ -z "$host" && -r "$HOME/.config/mba/host" ]]; then
  host="$(head -n 1 "$HOME/.config/mba/host")"
fi
[[ "$host" =~ ^[A-Za-z0-9_.@-]+$ ]] || fail "no host; use -H, MBA_HOST or ~/.config/mba/host"

paths=()
for path in "$@"; do
  # Raycast passes an empty argument when the optional path is left blank.
  [[ -z "$path" ]] || paths+=("$path")
done
if [[ ${#paths[@]} -eq 0 ]]; then
  if [[ -t 1 ]]; then
    paths=("$PWD")
  else
    selection="$(osascript -e 'set out to ""' \
      -e 'tell application "Finder" to repeat with f in (selection as alias list)' \
      -e 'set out to out & POSIX path of f & linefeed' \
      -e 'end repeat' -e 'return out' 2>/dev/null)" || fail "cannot read the Finder selection"
    while IFS= read -r line; do
      [[ -z "$line" ]] || paths+=("$line")
    done <<<"$selection"
    [[ ${#paths[@]} -gt 0 ]] || fail "nothing selected in Finder"
  fi
fi

# Every path relative to ~; nothing is copied until all are valid.
relatives=()
home_logical="$(normalize "$HOME")"
home_physical="$(cd "$HOME" && pwd -P)"
for path in "${paths[@]}"; do
  $pull || [[ -e "$path" ]] || fail "not found: $path"
  absolute="$(normalize "$path")"
  if [[ "$absolute" == "$home_logical"/?* ]]; then
    relative="${absolute#"$home_logical"/}"
  elif [[ "$absolute" == "$home_physical"/?* ]]; then
    relative="${absolute#"$home_physical"/}"
  else
    fail "not inside ~: $path"
  fi
  # The relative path is quoted for the remote shell below; control bytes would not survive.
  [[ ! "$relative" =~ [[:cntrl:]] ]] || fail "unsupported characters in: $path"
  relatives+=("$relative")
done
quoted=()
for relative in "${relatives[@]}"; do
  quoted+=("$(printf '%q' "$relative")")
done

# What each path is on the sending side: d = directory, g = Git work tree, f = file.
kinds=()
if $pull; then
  probe='for p in'
  for q in "${quoted[@]}"; do probe+=" $q"; done
  probe+='; do if [ -d "$p" ]; then if git -C "$p" rev-parse --is-inside-work-tree >/dev/null 2>&1;'
  probe+=' then echo g; else echo d; fi; elif [ -e "$p" ]; then echo f; else echo m; fi; done'
  output="$(ssh "$host" "$probe")" || fail "cannot reach $host"
  while IFS= read -r kind; do kinds+=("$kind"); done <<<"$output"
  [[ ${#kinds[@]} -eq ${#relatives[@]} ]] || fail "unexpected reply from $host"
  for i in "${!relatives[@]}"; do
    [[ "${kinds[i]}" != m ]] || fail "not found on $host: ~/${relatives[i]}"
  done
else
  for relative in "${relatives[@]}"; do
    if [[ -d "$HOME/$relative" ]]; then kinds+=(d); else kinds+=(f); fi
  done
fi

# Create every missing destination directory first (on the remote in one connection).
directories=()
for i in "${!relatives[@]}"; do
  if [[ "${kinds[i]}" != f ]]; then
    directories+=("${relatives[i]}")
  elif [[ "${relatives[i]}" == */* ]]; then
    directories+=("${relatives[i]%/*}")
  fi
done
if ! $dry_run && [[ ${#directories[@]} -gt 0 ]]; then
  if $pull; then
    for directory in "${directories[@]}"; do
      mkdir -p -- "$HOME/$directory" || fail "cannot create ~/$directory"
    done
  else
    mkdirs="mkdir -p --"
    for directory in "${directories[@]}"; do mkdirs+=" $(printf '%q' "$directory")"; done
    ssh "$host" "$mkdirs" || fail "cannot create the destination on $host"
  fi
fi

options=(-a -u --partial --exclude=.DS_Store)
$all || options+=(--exclude=.git)
# The local rsync reads .gitignore when sending; a remote openrsync cannot, see below.
$all || $pull || options+=(-f ':- .gitignore')
$dry_run && options+=(-n)
[[ -t 1 ]] && options+=(-i)
# rsync 3.2.4+ quotes remote paths itself; keep the older behaviour that the
# quoting above expects (macOS's openrsync already has it).
if rsync --help 2>&1 | grep -q -- '--old-args'; then
  options+=(--old-args)
fi

list="$(mktemp)"
trap 'rm -f "$list"' EXIT

for i in "${!relatives[@]}"; do
  local_path="$HOME/${relatives[i]}"
  remote_path="${quoted[i]}"
  extra=()
  if [[ "${kinds[i]}" != f ]]; then
    local_path+=/
    remote_path+=/
  fi
  if $pull && ! $all && [[ "${kinds[i]}" == g ]]; then
    # Let Git on the remote name the files: tracked plus untracked-not-ignored,
    # minus deletions not yet committed (a missing name stops openrsync).
    ssh "$host" "cd ${quoted[i]} && git ls-files -z --cached --others --exclude-standard |
      zsh -c 'for f in \${(0)\"\$(cat)\"}; do [[ -e \$f || -L \$f ]] && print -rN -- \$f; done'" >"$list" ||
      fail "cannot list files in ~/${relatives[i]} on $host"
    extra=(-0 --files-from="$list")
  fi
  if $pull; then
    [[ ! -t 1 ]] || echo "← $host:~/${relatives[i]}"
    rsync "${options[@]}" ${extra[@]+"${extra[@]}"} "$host:$remote_path" "$local_path" ||
      fail "rsync from $host failed for ~/${relatives[i]}"
  else
    [[ ! -t 1 ]] || echo "→ $host:~/${relatives[i]}"
    rsync "${options[@]}" "$local_path" "$host:$remote_path" ||
      fail "rsync to $host failed for ~/${relatives[i]}"
  fi
done

direction="to"
$pull && direction="from"
summary="${#relatives[@]} path(s) synced $direction $host"
$dry_run && summary="dry run: ${#relatives[@]} path(s) checked $direction $host"
[[ -t 1 ]] || notify "$summary"
echo "$summary"
