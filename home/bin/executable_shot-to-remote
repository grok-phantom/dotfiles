#!/usr/bin/env bash
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Screenshot to Remote
# @raycast.mode silent
# Optional parameters:
# @raycast.icon 📸
# @raycast.packageName Dotfiles
# @raycast.description Select a screen area, upload it to the remote dev host and paste its path.
set -eufo pipefail

exec "$(dirname "$0")/clip-to-remote" -s "$@"
