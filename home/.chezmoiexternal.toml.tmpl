{{- if and (eq ((get . "profile") | default "full") "full") (eq ((get . "update_component") | default "config") "externals") -}}
{{- range .external_lock }}
{{- $target := .target }}
{{- if eq .kind "font" }}
{{- if and (not $.ephemeral) (has $.chezmoi.os (list "darwin" "linux")) }}
{{- $fontDir := "Library/Fonts" }}
{{- if eq $.chezmoi.os "linux" }}{{ $fontDir = ".local/share/fonts" }}{{ end }}
[{{ joinPath $fontDir $target | quote }}]
    type = "file"
    url = {{ .url | quote }}
    checksum.sha256 = {{ .sha256 | quote }}
{{- end }}
{{- else if eq .kind "skills" }}
{{- /* One upstream archive holds many agent skills; each lands in its own exact directory,
       only where the CLI it drives is installed. */}}
{{- if lookPath .requires }}
{{- $item := . }}
{{- range .skills }}
[{{ joinPath $target . | quote }}]
    type = "archive"
    url = {{ $item.url | quote }}
    checksum.sha256 = {{ $item.sha256 | quote }}
    stripComponents = 3
    exact = true
    include = {{ list (printf "*/skills/%s/**" .) | toJson }}
{{ end }}
{{- end }}
{{- else }}
[{{ $target | quote }}]
    type = "archive"
    url = {{ .url | quote }}
    checksum.sha256 = {{ .sha256 | quote }}
    stripComponents = {{ (get . "strip") | default 1 }}
    exact = true
{{ if (get . "include") }}
    include = {{ .include | toJson }}
{{ end }}
{{- end }}
{{ end }}
{{- end }}
