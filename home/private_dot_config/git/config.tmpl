{{- $name := (get . "git_name") | default "" -}}
{{- $email := (get . "email") | default "" -}}
{{- $personalEmail := (get . "personal_email") | default "" -}}
{{- $personalDir := (get . "personal_git_dir") | default "~/workspace/personal/" -}}
{{ if or $name $email -}}
[user]
{{ if $name }}
    name = {{ $name | quote }}
{{ end }}
{{ if $email }}
    email = {{ $email | quote }}
{{ end }}
{{ end -}}
[core]
	autocrlf = input
	pager = less -FX
	quotepath = false
{{- if get . "git_hooks_path" }}
	# Set by this machine's management tooling, which rewrites it here; mirrored so chezmoi sees no drift.
	hooksPath = {{ .git_hooks_path }}
{{- end }}
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = default
[include]
    path = ~/.config/git/local.conf
{{ if $personalEmail -}}
[includeIf "gitdir:{{ $personalDir }}"]
    path = ~/.config/git/personal.conf
{{ end -}}
{{ if get . "automation_git_global" -}}
{{- $gh := "gh" -}}
{{- if lookPath "gh" -}}{{- $gh = lookPath "gh" -}}{{- end -}}
# automation_git_global: all git on this host runs unattended, like automation_git does for
# Claude Code: GitHub over HTTPS with gh's token, commits signed with this machine's own key.
# Last in the file so it wins over the 1Password signer set in personal.conf.
[credential "https://github.com"]
    helper =
    helper = !{{ $gh }} auth git-credential
[url "https://github.com/"]
    insteadOf = git@github.com:
    insteadOf = ssh://git@github.com/
[gpg "ssh"]
    program = ssh-keygen
[user]
    signingkey = {{ joinPath .chezmoi.homeDir ".ssh/automation-signing" }}
{{ end -}}
{{/* vim: set filetype=gitconfig: */}}
