.DS_Store
**/.DS_Store
.oh-my-zsh/cache/**
.oh-my-zsh/custom/themes/powerlevel10k/**/*.zwc
.vim_runtime/sources_non_forked/**
.vim_runtime/temp_dirs/**

{{ if ne .chezmoi.os "darwin" }}
.config/karabiner/**
.config/ghostty/**
Library/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.local/share/fonts
{{ end }}

{{- $claudeProxy := get . "claude_proxy" }}
{{- if not (kindIs "bool" $claudeProxy) }}
{{-   $claudeProxy = and (eq .chezmoi.os "darwin") (not (get . "ephemeral")) }}
{{- end }}
{{ if not $claudeProxy }}
{{   if not (get . "automation_git") }}
.claude/settings.json
{{   end }}
Library/LaunchAgents/local.dotfiles.gui-proxy.plist
{{ end }}

{{- $profile := (get . "profile") | default "full" }}
{{- if not (has $profile (list "core" "full")) }}
{{- fail "profile must be core or full" }}
{{- end }}
{{ if ne $profile "full" }}
.oh-my-zsh/**
.vim_runtime/**
.vim/**
.vimrc
.config/vim/**
.config/zsh/completions/**
.tmux.conf
.p10k.zsh
.condarc
.config/yazi/**
.config/karabiner/**
.config/ghostty/**
Library/**
.local/share/fonts/**
{{ end }}

{{- /* SSH is opt-in per machine (data.ssh_managed); personal hosts render only from 1Password. */}}
{{ if not (get . "ssh_managed") }}
.ssh/**
{{ else }}
{{   if not (get . "ssh_personal_document") }}
.ssh/config.d/personal.conf
{{   end }}
{{   if not (get . "ssh_personal_pubkey") }}
.ssh/personal-1password.pub
{{   end }}
{{ end }}

{{- /* nori config from 1Password, opt-in per Mac: data.nori_config_dir names the folder its
       deployment reads (nori or nori-mba) and data.nori_machine_json holds that Mac's own fields. */}}
{{- $noriDir := get . "nori_config_dir" | default "" }}
{{ if or (ne $noriDir "nori") (not (get . "nori_machine_json")) }}
.config/nori
.config/nori/**
{{ end }}
{{ if or (ne $noriDir "nori-mba") (not (get . "nori_machine_json")) }}
.config/nori-mba
.config/nori-mba/**
{{ end }}

{{- /* nori-watch, opt-in per Mac with data.nori_watch (checks the deployment in data.nori_config_dir).
       The Bark URL renders from 1Password only where nori's config does (data.nori_machine_json);
       elsewhere put it in ~/.config/nori-watch/bark.url by hand. */}}
{{ if not (and (get . "nori_watch") $noriDir) }}
Library/LaunchAgents/local.dotfiles.nori-watch.plist
.config/nori-watch
.config/nori-watch/**
{{ else if not (get . "nori_machine_json") }}
.config/nori-watch/bark.url
{{ end }}
