{{/* boolean feature tags */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $company := false -}}{{/* true if this machine is used for Company */}}
{{- $homebrew := true -}}
{{- "" -}}

{{/* Default data values */}}
{{- $email := "" -}}
{{- $gitName := "" -}}
{{- $hostname := .chezmoi.hostname -}}
{{- $proxyHost := "127.0.0.1" -}}
{{- $proxyHttpPort := "7890" -}}
{{- $proxySocksPort := "7890" -}}
{{- $sudo := false -}}{{/* whether sudo is available */}}
{{- "" -}}

{{/* Prompt */}}
{{- $company = promptBoolOnce . "company" "Is this a company machine?" -}}
{{- $ephemeral = promptBoolOnce . "ephemeral" "Is this ephemeral?" -}}
{{- $sudo = promptBoolOnce . "sudo" "Do you have sudo privileges on this machine?" -}}
{{- "" -}}

{{/* Identity is local data; never infer it from machine role. */}}
{{- $email = promptStringOnce . "email" "Git email (blank to configure locally)" -}}
{{- $gitName = promptStringOnce . "git_name" "Git name (blank to configure locally)" -}}
{{- $profile := promptChoiceOnce . "profile" "Configuration profile" (list "core" "full") "full" -}}

{{/* Preserve explicit local choices before applying capability guards. */}}
{{- if hasKey . "homebrew" -}}{{- $homebrew = .homebrew -}}{{- end -}}
{{- if hasKey . "hostname" -}}{{- $hostname = .hostname -}}{{- end -}}

{{/* Setup for ephemeral */}}
{{- if $ephemeral -}}
{{-   $homebrew = false -}}
{{- end -}}
{{- "" -}}

{{/* Route Claude Code through the local proxy; defaults on only for persistent Macs. */}}
{{- $claudeProxy := and (eq .chezmoi.os "darwin") (not $ephemeral) -}}
{{- if hasKey . "claude_proxy" -}}{{- $claudeProxy = .claude_proxy -}}{{- end -}}
{{- "" -}}

{{/* Homebrew requires sudo and non-ephemeral */}}
{{- if not $sudo -}}
{{-   $homebrew = false -}}
{{- end -}}
{{- "" -}}

{{/* Platform-specific local proxy ports */}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $proxyHttpPort = "6152" -}}
{{-   $proxySocksPort = "6153" -}}
{{- end -}}
{{- "" -}}

{{- if hasKey . "proxy_host" -}}{{- $proxyHost = .proxy_host -}}{{- end -}}
{{- if hasKey . "proxy_http_port" -}}{{- $proxyHttpPort = .proxy_http_port -}}{{- end -}}
{{- if hasKey . "proxy_socks_port" -}}{{- $proxySocksPort = .proxy_socks_port -}}{{- end -}}

{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}


[data]
    profile = {{ $profile | quote }}
    git_name = {{ $gitName | quote }}
    ephemeral = {{ $ephemeral }}
    email = {{ $email | quote }}
    company = {{ $company }}
    hostname = {{ $hostname | quote }}
    osid = {{ $osID | quote }}
    homebrew = {{ $homebrew }}
    sudo = {{ $sudo }}
    proxy_host = {{ $proxyHost | quote }}
    proxy_http_port = {{ $proxyHttpPort | quote }}
    proxy_socks_port = {{ $proxySocksPort | quote }}
    claude_proxy = {{ $claudeProxy }}
{{ if hasKey . "personal_email" }}
    personal_email = {{ .personal_email | quote }}
{{ end }}
{{ if hasKey . "personal_git_dir" }}
    personal_git_dir = {{ .personal_git_dir | quote }}
{{ end }}
{{ range $key := list "ssh_managed" "ssh_1password_agent" }}
{{   if hasKey $ $key }}
    {{ $key }} = {{ get $ $key }}
{{   end }}
{{ end }}
{{ range $key := list "ssh_personal_document" "ssh_personal_vault" }}
{{   if hasKey $ $key }}
    {{ $key }} = {{ get $ $key | quote }}
{{   end }}
{{ end }}
{{ if hasKey . "package_cask_groups" }}
    package_cask_groups = {{ .package_cask_groups | toJson }}
{{ end }}
{{ if hasKey . "package_cask_exclude" }}
    package_cask_exclude = {{ .package_cask_exclude | toJson }}
{{ end }}
