# Keep gpakosz's stock settings; put local overrides below.
source-file ~/.tmux/.tmux.conf.local

# Claude Code's native install runs a binary named after its version (e.g.
# 2.1.309), so name those windows by the title Claude sets (cmux shows it as the tab).
set -g automatic-rename-format '#{?pane_in_mode,[tmux],#{?#{m/r:^[0-9]+([.][0-9]+)+$,#{pane_current_command}},#{=/24/…:pane_title},#{pane_current_command}}}#{?pane_dead,[dead],}'
